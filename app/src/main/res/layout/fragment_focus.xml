<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background_light">

    <!-- Быстрый выбор времени -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_time_5"
            style="@style/ThemeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_time_15"
            style="@style/ThemeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_time_25"
            style="@style/ThemeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_time_45"
            style="@style/ThemeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45"/>

    </LinearLayout>

    <!-- Ручной ввод времени -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <EditText
            android:id="@+id/et_custom_time"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="мин"
            android:inputType="number"
            android:maxLength="3"
            android:textAlignment="center"
            android:background="@drawable/outline_button"
            android:padding="12dp"
            android:textSize="16sp"/>

        <Button
            android:id="@+id/btn_set_custom"
            style="@style/ThemeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Установить"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <!-- Таймер -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="05:00"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="@color/primary_green"
        android:fontFamily="monospace"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выберите время отдыха"
        android:textSize="18sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="48dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_start_break"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Начать отдых"
            android:backgroundTint="@color/primary_green"
            android:textColor="@color/white"
            app:cornerRadius="24dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginEnd="16dp"/>

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отмена"
            android:backgroundTint="@color/default_indicator"
            android:textColor="@color/text_primary"
            app:cornerRadius="24dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>