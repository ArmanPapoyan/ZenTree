<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/new_day_background">

    <TextView
        android:id="@+id/text_view_new_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/emoji_sprout"
        android:textSize="80sp"
        android:alpha="0"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/desc_new_day_emoji"/>

    <TextView
        android:id="@+id/text_view_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_day_title"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/primary_green_dark"
        android:alpha="0"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/text_view_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_day_message"
        android:textSize="16sp"
        android:textColor="#757575"
        android:alpha="0"/>

</LinearLayout>